# --- LLM provider -------------------------------------------------------
CODEVERIFY_PROVIDER=openrouter            # openrouter | openai | anthropic
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CODEVERIFY_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server (vLLM, Ollama)
CODEVERIFY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
CODEVERIFY_FALLBACK_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
# CODEVERIFY_LLM_BUDGET=45                 # hard cap on LLM requests per process

# --- Agent behaviour ----------------------------------------------------
CODEVERIFY_PLANNER_MODE=rules             # rules | llm
CODEVERIFY_INSPECTOR_LLM=0
CODEVERIFY_MAX_PATCH_ATTEMPTS=3
CODEVERIFY_MAX_GRAPH_STEPS=24
CODEVERIFY_REQUIRE_REVIEW=0

# --- Sandbox ------------------------------------------------------------
CODEVERIFY_SANDBOX=subprocess             # subprocess | docker
CODEVERIFY_SANDBOX_TIMEOUT=10
CODEVERIFY_LOG_LEVEL=INFO
